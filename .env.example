# --- Database (Prisma) ---
DATABASE_URL="postgresql://user:password@localhost:5432/nsfw_db?schema=public"

# --- Redis (BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- API (Fastify) ---
PORT=4000
API_HOST=0.0.0.0
# Secret for signing JWTs or session cookies
JWT_SECRET="change-me-in-production"

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Auth secret (if using Auth.js/NextAuth)
AUTH_SECRET="change-me-in-production"

# --- Worker / AI ---
# Path to the local model or API key if using a service
MODEL_PATH="./models/nsfw-classifier"
# Concurrency for BullMQ workers
WORKER_CONCURRENCY=2
