# --- Database (Prisma) ---
DATABASE_URL="postgresql://user:password@localhost:5432/nsfw_db?schema=public"

# --- Redis (BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- API (Fastify) ---
PORT=4000
API_HOST=0.0.0.0
# Secret for signing JWTs or session cookies
JWT_SECRET="change-me-in-production"

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:4000" # Points to the API
# Auth secret
BETTER_AUTH_SECRET="change-me-in-production"
BETTER_AUTH_URL="http://localhost:4000"

# --- Better Auth Social ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# --- Worker / AI ---
# Path to the local model or API key if using a service
MODEL_PATH="./models/nsfw-classifier"
# Concurrency for BullMQ workers
WORKER_CONCURRENCY=2
